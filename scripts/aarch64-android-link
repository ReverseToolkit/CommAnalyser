#!/bin/bash
# Link an aarch64-android cdylib with the NDK clang, after removing
# compiler-rt's cpu-model constructors from rustc's compiler_builtins.
#
# That object also supplies the __aarch64_* outline-atomic helpers the
# static QBDI/LLVM archives call. Its .init_array.90 entries run
# init_have_lse_atomics and __init_cpu_features at load, which call
# getauxval. The helpers only read __aarch64_have_lse_atomics, so with the
# constructor gone they stay on the LL/SC path.
set -euo pipefail

ndk_root="${ANDROID_NDK_HOME:-${NDK:-/root/Android/Sdk/ndk/27.2.12479018}}"
bin="${ndk_root}/toolchains/llvm/prebuilt/linux-x86_64/bin"
real="${bin}/aarch64-linux-android24-clang"

strip_rlib() {
    local src=$1
    local work member listing name
    work=$(mktemp -d)
    cp "$src" "${work}/lib.rlib"
    while IFS= read -r member; do
        case "$member" in
            *aarch64.o) ;;
            *) continue ;;
        esac
        (cd "$work" && "${bin}/llvm-ar" x lib.rlib "$member")
        listing=$("${bin}/llvm-readelf" -S "${work}/${member}")
        local -a copy_args=()
        while IFS= read -r line; do
            # "[15] .init_array.90 INIT_ARRAY ..."
            name=$(awk '{
                if ($1 ~ /^\[/) { print $2 }
            }' <<<"$line")
            case "$name" in
                *init_array*)
                    copy_args+=(--remove-section "$name")
                    ;;
            esac
        done <<<"$listing"
        if [[ ${#copy_args[@]} -eq 0 ]]; then
            echo "aarch64-android-link: ${member} has no init_array section" >&2
            exit 1
        fi
        "${bin}/llvm-objcopy" "${copy_args[@]}" \
            "${work}/${member}" "${work}/${member}.stripped"
        mv "${work}/${member}.stripped" "${work}/${member}"
        (cd "$work" && "${bin}/llvm-ar" r lib.rlib "$member")
    done < <("${bin}/llvm-ar" t "$src")
    echo "${work}/lib.rlib"
}

args=()
for arg in "$@"; do
    case "$arg" in
        *libcompiler_builtins-*.rlib)
            arg=$(strip_rlib "$arg")
            ;;
    esac
    args+=("$arg")
done

exec "$real" "${args[@]}"
